// ============================================================
//  Jenkinsfile — Software Quality Project
//  RETO: El equipo debe completar las secciones marcadas con TODO
//  Calidad del Software · VII Semestre
// ============================================================

pipeline {

    agent any

    environment {
        // TODO 1: Define las siguientes variables de entorno
         SONAR_PROJECT_KEY  = "software-quality-project"         // clave del proyecto en SonarQube
         SONAR_PROJECT_NAME = "software-quality-project"         // nombre visible en SonarQube
         SONAR_HOST_URL     = "http://sonarqube:9000"         // URL del contenedor SonarQube
         COVERAGE_THRESHOLD = "60"         // umbral mínimo de cobertura (sugerido: 60)
         REPORTS_DIR        = "sqp/reports"         // carpeta de reportes

        APP_NAME = "software-quality-project"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: "5"))
        timeout(time: 15, unit: "MINUTES")
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage("1 · Checkout") {
            steps {
                echo "Descargando código desde el fork del equipo..."
                checkout scm
                sh "ls -la"
            }
        }

        stage("2 · Preparar entorno") {
            steps {
                // TODO 2: Instala las dependencias de Python
                // Pista: usa pip3 con --no-cache-dir y el archivo requirements.txt
                // Crea también el directorio de reportes con mkdir -p
                sh """
                    cd sqp && pip3 install --no-cache-dir -r requirements.txt
                    mkdir -p ${REPORTS_DIR}
                """
            }
        }

        stage("3 · Pruebas unitarias") {
            steps {
                sh """
                    cd sqp && python3 -m pytest tests/ \\
                        --verbose \\
                        --cov=src \\
                        --cov-report=xml:reports/coverage.xml \\
                        --cov-report=html:reports/coverage_html \\
                        --cov-fail-under=${COVERAGE_THRESHOLD} \\
                        --junitxml=reports/test_results.xml
                """
            }
            post {
                always {
                    // TODO 4
                    junit "sqp/reports/test_results.xml"
                }
            }
        }

        stage("4 · Análisis SonarQube") {
            steps {
                withSonarQubeEnv("SonarQube") {
                    sh """
                        sonar-scanner \\
                            -Dsonar.projectKey=${SONAR_PROJECT_KEY} \\
                            -Dsonar.sources=sqp/src \\
                            -Dsonar.tests=sqp/tests \\
                            -Dsonar.python.coverage.reportPaths=sqp/reports/coverage.xml \\
                            -Dsonar.python.version=3
                    """
                }
            }
        }

        stage("5 · Quality Gate") {
            steps {
                // TODO 6: Espera el resultado del Quality Gate de SonarQube
                // Pista: usa timeout y waitForQualityGate abortPipeline: true
                echo "TODO: verificar Quality Gate"
                timeout(time: 15, unit: "MINUTES") {
                    waitForQualityGate abortPipeline: false
                }
            }
        }

        stage("6 · Resumen") {
            steps {
                sh """
                    echo "Proyecto : ${APP_NAME}"
                    echo "Branch   : \$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo N/A)"
                    echo "Commit   : \$(git rev-parse --short HEAD 2>/dev/null || echo N/A)"
                """
            }
        }
    }

    post {
        // TODO 7: Completa el bloque post con:
        //   always   — mensaje de estado del pipeline
        //   success  — mensaje de build exitoso
        //   failure  — mensaje de fallo con URL de SonarQube
        always {
            echo "Pipeline finalizado: ${currentBuild.currentResult}"
        }
    }
}
